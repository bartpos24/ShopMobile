<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/inventory_graph">

    <fragment
        android:id="@+id/loginFragment"
        android:name="pl.bartpos24.shopmobile.ui.LoginFragment"
        android:label="@string/menu_login"
        tools:layout="@layout/login_fragment"
        tools:showIn="@layout/activity_main" />
    <fragment
        android:id="@+id/findProductFragment"
        android:name="pl.bartpos24.shopmobile.ui.FindProductFragment"
        android:label="@string/menu_findProduct"
        tools:layout="@layout/find_product_fragment" >
    </fragment>

    <navigation
        android:id="@+id/inventory_graph"
        app:startDestination="@id/inventoryFragment">
        <fragment
            android:id="@+id/inventoryFragment"
            android:name="pl.bartpos24.shopmobile.ui.inventory.InventoryFragment"
            android:label="@string/menu_inventory"
            tools:layout="@layout/inventory_fragment" >
            <action
                android:id="@+id/action_inventoryFragment_to_inventoryPositionFragment"
                app:destination="@id/inventoryPositionFragment" />
        </fragment>
        <fragment
            android:id="@+id/inventoryPositionFragment"
            android:name="pl.bartpos24.shopmobile.ui.inventory.InventoryPositionFragment"
            android:label="@string/inventory_position_fragment_lbl"
            tools:layout="@layout/inventory_position_fragment" >
            <action
                android:id="@+id/action_inventoryPositionFragment_to_commonInventoryPositionFragment"
                app:destination="@id/commonInventoryPositionFragment" />
            <action
                android:id="@+id/action_inventoryPositionFragment_to_inventoryPositionEditFragment"
                app:destination="@id/inventoryPositionEditFragment" >
                <argument
                    android:name="inventoryPosition"
                    app:argType="pl.bartpos24.web.model.InventoryPosition" />
            </action>
            <action
                android:id="@+id/action_inventoryPositionFragment_to_addEditProductFragment"
                app:destination="@id/addEditProductFragment" />
        </fragment>
        <fragment
            android:id="@+id/commonInventoryPositionFragment"
            android:name="pl.bartpos24.shopmobile.ui.inventory.CommonInventoryPositionFragment"
            android:label="@string/common_inventory_position_fragment_lbl"
            tools:layout="@layout/common_inventory_position_fragment" >
            <action
                android:id="@+id/action_commonInventoryPositionFragment_to_commonInventoryPositionEditFragment"
                app:destination="@id/commonInventoryPositionEditFragment" >
                <argument
                    android:name="commonInventoryPosition"
                    app:argType="pl.bartpos24.web.model.CommonInventoryPosition" />
            </action>
        </fragment>
        <fragment
            android:id="@+id/inventoryPositionEditFragment"
            android:name="pl.bartpos24.shopmobile.ui.inventory.InventoryPositionEditFragment"
            android:label="@string/inventory_position_edit_fragment_lbl"
            tools:layout="@layout/inventory_position_edit_fragment" >
            <argument
                android:name="inventoryPosition"
                app:argType="pl.bartpos24.web.model.InventoryPosition" />
        </fragment>
        <fragment
            android:id="@+id/commonInventoryPositionEditFragment"
            android:name="pl.bartpos24.shopmobile.ui.inventory.CommonInventoryPositionEditFragment"
            android:label="@string/inventory_position_edit_fragment_lbl"
            tools:layout="@layout/common_inventory_position_edit_fragment" >
            <argument
                android:name="commonInventoryPosition"
                app:argType="pl.bartpos24.web.model.CommonInventoryPosition" />
        </fragment>
        <fragment
            android:id="@+id/addEditProductFragment"
            android:name="pl.bartpos24.shopmobile.ui.product.AddEditProductFragment"
            android:label="@string/add_edit_product_fragment_lbl"
            tools:layout="@layout/add_edit_product_fragment" >
            <argument
                android:name="product"
                app:argType="pl.bartpos24.web.model.Product"
                app:nullable="true" />
            <argument
                android:name="barcode"
                app:argType="string"
                app:nullable="true" />
        </fragment>
    </navigation>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="pl.bartpos24.shopmobile.ui.SettingsFragment"
        android:label="@string/menu_settings"
        tools:layout="@layout/settings_fragment" />
</navigation>